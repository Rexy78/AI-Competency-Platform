# Backend configuration
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/resume_analyzer
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
SECRET_KEY=change-me-to-a-strong-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional frontend config. Leave VITE_API_URL unset locally to use the Vite /api proxy.
# Set it to the API origin only when the API is hosted separately in production.
VITE_API_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
